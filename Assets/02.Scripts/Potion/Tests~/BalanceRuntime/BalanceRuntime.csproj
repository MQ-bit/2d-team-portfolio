    <Compile Include="../../Area/PotionAreaOwnership.cs" Link="Production/PotionAreaOwnership.cs" />
    <Compile Include="../../Area/PotionAreaTimeline.cs" Link="Production/PotionAreaTimeline.cs" />
    <Compile Include="../../Combination/PotionVaporizationBatch.cs" Link="Production/PotionVaporizationBatch.cs" />
    <Compile Include="../../../Entity/Status/Interface/IDamageable.cs" Link="Production/IDamageable.cs" />
