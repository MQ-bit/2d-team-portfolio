  _warningDialogueLines:
  - "\uD3EC\uC158\uC758 \uAC78\uCB49\uD558\uACE0 \uB5AB\uC740 \uB9DB\uC774 \uB2F9\uAE34\uB2E4."
  - "\uC774\uC0C1\uD55C \uAC08\uC99D\uC774 \uB290\uAEF4\uC9C4\uB2E4."
  - "\uC190\uBC1C\uC774 \uC870\uAE08\uC529 \uB5A8\uB9AC\uAE30 \uC2DC\uC791\uD55C\uB2E4."
  - "\uC57D\uAC04\uC529 \uBD88\uC548\uD55C \uAC10\uC815\uC774 \uB4E0\uB2E4."
  _criticalDialogueLines:
  - "\uBA38\uB9AC\uAC00 \uAE68\uC9C8 \uB4EF \uC625\uC8C4\uC778\uB2E4..."
  - "\uB208\uC55E\uC774 \uBE59\uBE59 \uB3CC\uAE30 \uC2DC\uC791\uD55C\uB2E4..."
  - "\uC0AC\uC9C0\uAC00 \uC81C\uBA4B\uB300\uB85C \uB4A4\uD2C0\uB9B0\uB2E4..."
  - "\uBAB8 \uC18D\uC774 \uAC70\uBBF8\uB85C \uAC00\uB4DD \uCC28 \uC788\uB294 \uAC83
    \uAC19\uB2E4..."
